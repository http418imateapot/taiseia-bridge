# Line endings are LF everywhere in this repository.
#
# Not a style preference: a shell script committed with CRLF has "\r" on the
# end of its shebang, and the only symptom is a build machine reporting that
# it cannot find an interpreter named "bash\r".
* text=auto eol=lf

*.sh   text eol=lf
*.c    text eol=lf
*.h    text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.conf text eol=lf
*.cmake text eol=lf
*.py   text eol=lf
Makefile text eol=lf
CMakeLists.txt text eol=lf
